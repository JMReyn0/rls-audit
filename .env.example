# rls-audit reads a connection string from --db-url or one of these.
# Use the Supabase "postgres" / service role — the tool only runs SELECTs
# against pg_catalog / information_schema.

# Supabase: Project Settings -> Database -> Connection string -> URI
SUPABASE_DB_URL=postgres://postgres:PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

# or a generic Postgres
# DATABASE_URL=postgres://user:pass@host:5432/dbname
